{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-companion-demo/scene_generation/generated_scene_manifest.schema.json",
  "title": "Generated Scene Manifest",
  "description": "Deterministic output produced by compiling a scene recipe against a specific registry version and seed. Records every generated object placement, hash for reproducibility verification, and audit trail.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Version of the manifest schema.",
      "minimum": 1
    },
    "manifest_id": {
      "type": "string",
      "description": "Unique manifest identifier, typically '{recipe_id}-{seed}-{short_hash}'.",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "recipe_id": { "type": "string" },
    "recipe_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "registry_id": { "type": "string" },
    "registry_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "seed": { "type": "integer" },
    "generation_hash": {
      "type": "string",
      "description": "SHA-256 hash of the generation input: recipe content + registry_version + seed.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "room": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "dimensions_m": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "depth": { "type": "number" },
            "height": { "type": "number" }
          },
          "required": ["width", "depth", "height"],
          "additionalProperties": false
        },
        "lighting": { "$ref": "#/$defs/lighting_spec" },
        "bounds": { "$ref": "#/$defs/bbox" },
        "floor": { "$ref": "#/$defs/floor_spec" },
        "walls": {
          "type": "array",
          "items": { "$ref": "#/$defs/wall_spec" }
        },
        "openings": {
          "type": "array",
          "items": { "$ref": "#/$defs/opening_spec" }
        }
      },
      "required": ["name", "dimensions_m"],
      "additionalProperties": false
    },
    "placements": {
      "type": "array",
      "items": { "$ref": "#/$defs/placement_entry" }
    },
    "audit": {
      "type": "object",
      "properties": {
        "compiler_version": { "type": "string" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["compiler_version"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "manifest_id", "recipe_id", "recipe_version", "registry_id", "registry_version", "seed", "generation_hash", "room", "placements"],
  "additionalProperties": false,
  "$defs": {
    "bbox": {
      "type": "object",
      "properties": {
        "min": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "max": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "lighting_spec": {
      "type": "object",
      "properties": {
        "key_color": { "$ref": "#/$defs/color3" },
        "key_energy": { "type": "number", "minimum": 0, "maximum": 3 },
        "key_rotation_deg": { "$ref": "#/$defs/vector3" },
        "fill_color": { "$ref": "#/$defs/color3" },
        "fill_energy": { "type": "number", "minimum": 0, "maximum": 4 },
        "fill_position": { "$ref": "#/$defs/vector3" },
        "fill_range_m": { "type": "number", "minimum": 0.5, "maximum": 12 },
        "accent_color": { "$ref": "#/$defs/color3" },
        "accent_energy": { "type": "number", "minimum": 0, "maximum": 4 },
        "accent_position": { "$ref": "#/$defs/vector3" },
        "accent_range_m": { "type": "number", "minimum": 0.5, "maximum": 12 }
      },
      "additionalProperties": false
    },
    "color3": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 3,
      "maxItems": 3
    },
    "vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "floor_spec": {
      "type": "object",
      "properties": {
        "thickness_m": { "type": "number" },
        "material_key": { "type": "string" }
      },
      "required": ["thickness_m", "material_key"],
      "additionalProperties": false
    },
    "wall_spec": {
      "type": "object",
      "properties": {
        "wall_id": { "type": "string" },
        "thickness_m": { "type": "number" },
        "height_m": { "type": "number" },
        "material_key": { "type": "string" }
      },
      "required": ["wall_id", "thickness_m", "height_m", "material_key"],
      "additionalProperties": false
    },
    "opening_spec": {
      "type": "object",
      "properties": {
        "opening_id": { "type": "string" },
        "type": { "type": "string" },
        "wall_id": { "type": "string" },
        "position": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "size": {
          "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
        }
      },
      "required": ["opening_id", "type", "wall_id"],
      "additionalProperties": false
    },
    "placement_entry": {
      "type": "object",
      "properties": {
        "semantic_id": { "type": "string" },
        "asset_id": { "type": "string" },
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation_deg": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "interaction_point": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "affordances": {
          "type": "array",
          "items": { "type": "string" }
        },
        "needs_proximity": { "type": "boolean" },
        "effects": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "initial_state": { "type": "string" },
        "properties": { "type": "object" },
        "consumable": { "type": "boolean" }
      },
      "required": ["semantic_id", "asset_id", "display_name", "position", "interaction_point"],
      "additionalProperties": false
    }
  }
}
